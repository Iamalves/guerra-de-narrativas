# Copie para backend/.env e ajuste. O .env não vai para o controle de versão.
# Banco do docker-compose (banco/docker-compose.yml): porta 5433, usuário e banco "guerra"
DATABASE_URL=postgres://guerra:guerra_local@127.0.0.1:5433/guerra
# porta da API (o frontend em modo de desenvolvimento encaminha /api para cá)
PORT=3001
# endereços do frontend que podem chamar a API de outro domínio (separados por vírgula). Vazio: só o mesmo endereço.
CORS_ORIGENS=
# endereço do jogo (para onde o jogador volta depois de pagar)
FRONT_URL=http://localhost:5173
# Mercado Pago (Checkout Pro): Access Token da sua aplicação. Use o de TESTE até tudo estar conferido.
MP_ACCESS_TOKEN=
# chave secreta dos webhooks (painel do Mercado Pago → Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=
# endereço público do backend, em https (ex.: https://api.seujogo.com.br), para receber os avisos de pagamento
API_URL_PUBLICA=
# 1 = simulador de pagamento local, sem cobrar nada (só fora de produção e só sem Access Token)
MP_SIMULADO=1
